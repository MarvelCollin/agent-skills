datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  issuedAt   DateTime @default(now())
}

model Customer {
  id       String    @id
  invoices Invoice[]
}
